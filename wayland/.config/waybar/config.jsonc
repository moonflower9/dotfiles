{
    "layer": "top",
    "position": "top",
    "spacing": 5,
    "modules-left": [
        "custom/power",
        "ext/workspaces"
    ],
    "modules-center": [
        "clock",
        "custom/weather"
    ],
    "modules-right": [
        "tray",
        "custom/spacer",
        "bluetooth",
        "pulseaudio",
        "network",
        "custom/spacer",
        "cpu",
        "memory",
        "temperature",
        "custom/spacer",
        "custom/uptime"
    ],
    "ext/workspaces": {
        "format": "{icon}",
        "ignore-hidden": true,
        "on-click": "activate",
        "on-click-right": "deactivate",
        "sort-by-id": true
    },
    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    "bluetooth": {
        "format": "󰂲",
        "format-on": "{icon}",
        "format-off": "{icon}",
        "format-connected": "{icon}",
        "format-icons": {
            "on": "󰂯",
            "off": "󰂲",
            "connected": "󰂱"
        },
        "on-click": "blueman-manager",
        "tooltip-format-connected": "{device_enumerate}"
    },
    "clock": {
        "timezone": "Pacific/Auckland",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M - %A}",
        "format-alt": "{:%d-%m-%y}",
        "on-click-right": "notify-send -a 'Clock' 'Today is: ' \"$(date '+%d-%m-%y')\"",
        "interval": 60
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "interval": 1800,
        "return-type": "json"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": true,
        "tooltip-format": "Load: {load}"
    },
    "memory": {
        "interval": 5,
        "format": "  {used:0.1f}G",
        "tooltip-format": "  Memory: {used:0.1f}G/{total:0.1f}G"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 85,
        "format-critical": "{temperatureC}°C {icon} CRITICAL",
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%)  ",
        "format-ethernet": "󰈀 ",
        "format-linked": "{ifname} (No IP) 󰩟 ",
        "format-disconnected": "Disconnected ⚠ ",
        "on-click": "foot nmtui",
        "on-click-right": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "wlogout"
    },
    "custom/spacer": {
        "format": "│",
        "tooltip": false
    },
    "custom/uptime": {
        "format": "{}",
        "format-icon": [
            ""
        ],
        "tooltip-format": "Uptime: {}",
        "interval": 1600,
        "exec": "~/.config/waybar/scripts/uptime.sh"
    }
}
