{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10,
    },
    "separator": "",
    "color": {
      "keys": "#ff8800",
    },
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "os",
      "format": "{name}",
    },
    {
      "type": "kernel",
      "key": "ker",
    },
    {
      "type": "shell",
      "key": "shl",
      "format": "{pretty-name}",
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}",
    },
    {
      "type": "cpu",
      "key": "cpu",
      "format": "{name}",
    },
    {
      "type": "disk",
      "key": "dsk",
      "folders": ["/"],
      "format": "{size-used} / {size-total}",
    },
  ],
}
